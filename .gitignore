# --- Dependencies ---
node_modules/
**/node_modules/

# --- Logs ---
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build Output ---
/dist/
**/dist/
/.vite/
**/.vite/

# --- Coverage ---
/coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# --- Environment ---
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Process & Runtime ---
*.pid
*.seed
*.seed.*
*.pid.*

# --- OS Files ---
.DS_Store
Thumbs.db

# --- IDE/Editor ---
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Cache ---
.eslintcache
.cache

# --- Uploads ---
uploads/
**/uploads/

