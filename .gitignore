# ==============================
# Secure & clean defaults (Root)
# Covers both: frontend/ + backend/
# ==============================

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Logs / debug ---
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build / output ---
# Vite/React
/dist/
**/dist/
/.vite/
**/.vite/

# Node/coverage
/coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# --- Environment / secrets (MOST IMPORTANT) ---
.env
.env.*
!.env.example

# If you use dotenv-generated local files
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Runtime artifacts ---
# Express apps sometimes create temp files; keep generic
*.pid
*.seed
*.seed.*
*.pid.*

# --- OS / editor ---
.DS_Store
Thumbs.db

.vscode/
!.vscode/extensions.json
.idea/
*.iml

# JetBrains / tooling
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Vite/ESLint sometimes caches ---
.eslintcache
.cache

# --- Backend specific common local dirs (safe defaults) ---
# (Only if you create them; gitignore won't affect source files)
uploads/
**/uploads/

# --- Docker (optional) ---
# *.env in container contexts is covered above

# --- Keep repo-root config files tracked ---
# (No un-ignore rules here; adjust if you need.)

