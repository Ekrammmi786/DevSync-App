# ─── Server ───
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Database ───
MONGO_URI=mongodb://localhost:27017/devsync

# ─── JWT Secrets (use strong 256-bit random strings) ───
JWT_SECRET_KEY=your-256-bit-access-token-secret-key
JWT_REFRESH_SECRET_KEY=your-256-bit-refresh-token-secret-key

# ─── Admin ───
ADMIN_SECRET_KEY=your-strong-admin-secret-key

# ─── SMTP / Email (Mailtrap recommended for dev) ───
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM=noreply@devsync.com

# ─── Stream Chat (getstream.io) ───
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# ─── Stream Video (same keys as Stream Chat usually) ───
STREAM_VIDEO_API_KEY=your-stream-api-key
STREAM_VIDEO_API_SECRET=your-stream-api-secret

# ─── Cloudinary (image/file uploads) ───
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
